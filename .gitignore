# Secrets / local config — never commit real credentials
.env
.env.*
!.env.example
env.sh
env_*.sh
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
*.venv/

# Engine run state — per-environment, regenerated by analyze/run, not source
_state/
_state_v2/
*.ckpt.json

# Logs and run output
*.log
logs/

# Data — never commit real or anonymized data dumps/exports
*.dump
*.sql
slice_data/
report/

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
*.swp

