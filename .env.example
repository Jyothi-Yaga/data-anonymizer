# obi_anonymizer .env  — copy to `.env` (same folder) and fill in real values.
# The script loads this automatically at startup. Anything already exported in the
# terminal takes precedence, so this only supplies values you haven't set.
# Keep the real `.env` OUT of version control (it holds credentials).  chmod 600 .env
#
# Connection-string format (ODBC Driver 17):
#   DRIVER={ODBC Driver 17 for SQL Server};SERVER=<host,port>;DATABASE=<db>;UID=<user>;PWD=<pwd>;Encrypt=<yes|no>;TrustServerCertificate=<yes|no>;

# ── VERSION 1 (present): anonymize a migrated slice; mapping = shared obi.mapping_slice ──
# DATA = the local SQL Server slice being anonymized (per user: obi_nick_slice / obi_kiran_slice).
# Note: OBI_ANON_CS (the existing var) still works and takes precedence if set in the terminal.
V1_DATA_CS=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost,1433;DATABASE=obi_nick_slice;UID=sa;PWD=__SA_PASSWORD__;Encrypt=no;TrustServerCertificate=yes;
# MAPPING = shared Azure obi-sql-db (table obi.mapping_slice)
V1_MAP_CS=DRIVER={ODBC Driver 17 for SQL Server};SERVER=obi-poc-server.database.windows.net;DATABASE=obi-sql-db;UID=obi_admin;PWD=__AZURE_PASSWORD__;Encrypt=yes;TrustServerCertificate=no;

# ── VERSION 2 (new): anonymize obi-sql-db tables directly; mapping = obi.mapping_xref ──
# For v2 the DATA and MAPPING live in the same Azure DB (obi-sql-db); V2_MAP_CS defaults to
# V2_DATA_CS if omitted. XREF table defaults to mapping_xref.
V2_DATA_CS=DRIVER={ODBC Driver 17 for SQL Server};SERVER=obi-poc-server.database.windows.net;DATABASE=obi-sql-db;UID=obi_admin;PWD=__AZURE_PASSWORD__;Encrypt=yes;TrustServerCertificate=no;
# V2_MAP_CS=<defaults to V2_DATA_CS>

# ── Mapping table name per version — dynamic, no code change needed ──
# Which shared table --version 1 / --version 2 read & write for reuse-first lookups.
# Defaults shown below. Set V1_XREF=mapping_xref to make V1 share V2's table instead of
# mapping_slice (e.g. so a V1 run reuses fakes a V2 run already established for the same value).
V1_XREF=mapping_slice
V2_XREF=mapping_xref

# Optional: HuggingFace cache for GLiNER (freetext columns)
# HF_HOME=/mnt/obi/hf
